# A local stand-in for the (separately-maintained, out-of-repo) stdlib's
# Core/Compiler/Options module, scoped to this example so the '@option'/'@link'/'when'
# feature set can be exercised end-to-end without depending on an external stdlib checkout.

pub type OperatingSystem = enum(i32) {
    Linux = 0
    Windows = 1
    MacOS = 2
    Wasm32 = 3
    Other = 4
}

pub type Architecture = enum(i32) {
    X86 = 0
    X86_64 = 1
    Arm64 = 2
    Wasm32 = 3
    Wasm64p32 = 4
    Other = 5
}

pub const target_os: OperatingSystem = @option("build/target_os", .Linux)
pub const target_arch: Architecture = @option("build/target_arch", .X86_64)
