// example_sibling_type_layout — two related array-element resolution rules:
//
//  1. a by-value array element type declared LATER in the file must lay out correctly
//     regardless of symbol-table iteration order (TYPE-20; the pre-fix failure was
//     iteration-order-dependent);
//  2. an array element reached only BEHIND a pointer must NOT force full layout —
//     'next: *[4]Node' inside Node itself is valid (the user did store it behind a
//     pointer) and was falsely rejected as a by-value cycle by the first TYPE-20 fix.
//
// Array sizes are recomputed from the element at query time, so the pointee-position
// intern cannot bake a stale mid-layout size either.
//
// Expected: exit code 40 — size_of(Outer) = 3 * 8, plus size_of([2]Inner) = 16.

type Node = struct {
    value: i32
    next: *[4]Node
}

type Outer = struct {
    items: [3]Inner
}

type Inner = struct {
    a: i32 = 5
    b: i32 = 2
}

pub fn main() -> i32 {
    mut n: Node = default
    mut o: Outer = default
    return cast(size_of(Outer), i32) + cast(size_of([2]Inner), i32)
}
