// example_sibling_type_layout — a by-value array element type declared LATER in the file
// must lay out correctly regardless of symbol-table iteration order. The array case used
// resolve_type_impl (shallow), so whether Inner was already laid out when Outer's array
// computed its size depended on unordered-map iteration order, and 'field stores T by
// value, which is not yet a complete type' could fire spuriously (found during CHECK-10;
// logged as TYPE-20). This fixture pins the correct behavior; the pre-fix failure was
// iteration-order-dependent and not deterministically reproducible.
//
// Expected: exit code 24 — size_of(Outer) = 3 * (4 + 4).

type Outer = struct {
    items: [3]Inner
}

type Inner = struct {
    a: i32 = 5
    b: i32 = 2
}

pub fn main() -> i32 {
    mut o: Outer = default
    return cast(size_of(Outer), i32)
}
