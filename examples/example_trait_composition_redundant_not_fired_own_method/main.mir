pub type Y = trait { fn run(self) -> i32 }
pub type X = trait(Y) { fn extra(self) -> i32 }
pub type Impl = struct { v: i32 }
impl X for Impl {
    fn run(self) -> i32 { return self.v }
    fn extra(self) -> i32 { return self.v + 1 }
}
pub fn main() -> i32 {
    mut i: Impl = { .v = 3 }
    const x: X = &i
    return x.run() + x.extra() - 3 - 4
}
