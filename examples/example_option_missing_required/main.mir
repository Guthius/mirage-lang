# example_option_missing_required.mir — REJECTION CASE. An '@option' with no default
# value must be supplied via '--opt'; if it isn't, sema reports exactly which key is
# missing and how to supply it.
#
# Expected (with no '--opt required_thing=...' passed): compilation fails with
#   error: required option 'required_thing' was not provided.
#          Pass it with: --opt required_thing=<value>

const x := @option("required_thing")

pub fn main() {
}
