// example_when_fn_body.mir — demonstrates the 'when' statement inside a function body.
//
// The condition here is a compile-time constant (an '#option'-backed const), so only the
// selected branch's code is emitted by codegen — but BOTH branches are always type-checked
// (a hard sema requirement), which is why the unselected branch can't silently rot: try
// flipping '--opt use_backslash=true' and both branches still have to compile cleanly.

ext fn printf(fmt: *u8, ...) -> i32

const use_backslash := #option("use_backslash", false)

pub fn get_separator() -> []u8 {
    when use_backslash {
        return "\\"
    } else {
        return "/"
    }
}

pub fn main() -> i32 {
    const sep := get_separator()
    printf("separator: %s\n", cast(sep, *u8))
    return 0
}
