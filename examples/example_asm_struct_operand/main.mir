// example_asm_struct_operand.mir — REJECTION CASE. Only scalar and pointer types are
// supported as asm operands; a struct-typed local is a sema error.
//
// Expected: compilation fails with
//   error: asm operand 'p' has type 'Point', but only scalar and pointer types are supported
//          in asm operands

type Point = struct {
    x: i32 = 0
    y: i32 = 0
}

pub fn use_struct_operand() {
    const p: Point = { .x = 1, .y = 2 }
    asm {
        mov rax, p
    }
}

pub fn main() {
    use_struct_operand()
}
