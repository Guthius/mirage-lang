// A by-ref payload capture ('.Variant(&v):') that is let out of its own arm.
//
// Codegen emits the match/switch operand as a VALUE into one scratch slot per function, so
// '&v' points at a compiler temporary rather than at the original object -- and the next
// match through that slot overwrites it. Anything that reads the pointer after the arm has
// ended therefore sees whatever was matched most recently.
//
// This compiles (the escape is a warning, not an error, because the check is a conservative
// syntactic approximation), so the fixture's exit code pins nothing interesting. What it
// pins is the set of escape routes that are detected -- see tests/payload_capture_test.py.

type Arg = union(enum) {
    small: u8
    large: u64
}

fn observe(p: *u64) -> u64 { return p.* }

mut global_ptr: *u64 = nil

type Holder = struct {
    ptr: *u64 = nil
}

type Boxed = union(enum) {
    none
    ptr: struct { p: *u64 }
}

// via an assignment to a binding declared outside the arm
pub fn escape_via_assignment(a: Arg) -> u64 {
    mut out: *u64 = nil
    switch a {
        .large(&v): {
            out = v
        },
        .small(v): {},
    }
    if !out { return 0 }
    return out.*
}

// via a call argument
pub fn escape_via_call(a: Arg) -> u64 {
    mut total: u64 = 0
    switch a {
        .large(&v): {
            total = observe(v)
        },
        .small(v): {},
    }
    return total
}

// via a store into a global
pub fn escape_via_global(a: Arg) {
    switch a {
        .large(&v): {
            global_ptr = v
        },
        .small(v): {},
    }
}

// via an aggregate initializer
pub fn escape_via_struct(a: Arg) -> Holder {
    mut h: Holder = default
    switch a {
        .large(&v): {
            h = { .ptr = v }
        },
        .small(v): {},
    }
    return h
}

// via a return, out of the match-expression form
pub fn escape_via_return(a: Arg) -> *u64 {
    switch a {
        .large(&v): {
            return v
        },
        .small(v): {},
    }
    return nil
}

// via a local BOUND to the capture first. This is the under-report the check used to have:
// 'p' holds the same pointer, but nothing followed it there, so 'global_ptr = p' escaped
// silently. Binding it is not itself an escape -- 'p' is arm-local too -- so what matters is
// that the pointer is followed, not that the binding is flagged.
pub fn escape_via_alias(a: Arg) -> u64 {
    switch a {
        .large(&v): {
            const p := v
            global_ptr = p
        },
        .small(v): {},
    }
    if !global_ptr { return 0 }
    return global_ptr.*
}

// via a tagged-variant payload. Structurally identical to the struct-literal case above,
// which WAS detected -- this arm was simply missing from the walker.
pub fn escape_via_variant_payload(a: Arg) -> u64 {
    mut boxed: Boxed = .none
    switch a {
        .large(&v): {
            boxed = .ptr{.p = v}
        },
        .small(v): {},
    }
    return 0
}

// SAFE: a local bound to something else SHADOWS the capture, so uses of that name afterwards
// are not uses of the pointer. Must not warn.
pub fn safe_shadowed_alias(a: Arg) -> u64 {
    mut sink: *u64 = nil
    switch a {
        .large(&v): {
            const p := v
            const q := p
            const p2: *u64 = nil
            sink = p2
        },
        .small(v): {},
    }
    return 0
}

// SAFE: reading through the pointer while the arm is still live. Must not warn.
pub fn safe_read_through(a: Arg) -> u64 {
    mut got: u64 = 0
    switch a {
        .large(&v): {
            got = v.*
        },
        .small(v): {},
    }
    return got
}

pub fn main() -> i32 {
    const a: Arg = .large{.v = 7}
    if safe_read_through(a) != 7 { return 1 }
    return 0
}
