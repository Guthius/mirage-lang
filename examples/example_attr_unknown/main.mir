// example_attr_unknown.mir — REJECTION CASE. Only 'no_return', 'naked', 'always_inline',
// 'section', and 'init' are recognized attribute names; anything else is rejected rather than
// silently ignored, since silently-ignored unknown attributes are how dead cruft accumulates.
//
// Expected: compilation fails with
//   error: unknown attribute '@frobulate'. Known attributes: no_return, naked, always_inline,
//          section, init.

@frobulate
fn f() {
}

pub fn main() {
}
