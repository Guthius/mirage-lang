// example_generics_eager_impl_method/main.mir
//
// Eager checking covers the methods of a generic type's 'impl' block, not just generic free
// functions. 'Box' is never instantiated anywhere in this program, so nothing else would
// ever look at 'get's body.
//
// 'self' here is a real instantiation of 'Box' with its argument left unbound, so the
// receiver's fields keep whatever types are already known — a misspelled field, or a
// mismatch between two concretely-typed fields, is caught here too. Only the genuinely
// parameter-dependent parts stay unchecked.
//
// Expected: rejected with "unknown function 'missing_helper'".

pub type Box[T: type] = struct {
    v: T
}

impl Box[T: type] {
    pub fn get(self) -> T {
        missing_helper(self)
        return self.v
    }
}

pub fn main() -> i32 {
    return 0
}
