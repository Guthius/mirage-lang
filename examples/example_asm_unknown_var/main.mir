# example_asm_unknown_var.mir — REJECTION CASE. 'unknown_name' is not declared anywhere in
# scope, so referencing it inside an asm block is a sema error, exactly like referencing an
# undeclared identifier anywhere else in the language.
#
# Expected: compilation fails with
#   error: unknown identifier 'unknown_name' in asm block.

pub fn use_unknown_var() {
    asm {
        mov rax, unknown_name
    }
}

pub fn main() {
    use_unknown_var()
}
