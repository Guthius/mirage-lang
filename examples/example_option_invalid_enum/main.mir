// example_option_invalid_enum.mir — REJECTION CASE. When an '@option' target type is an
// enum, the '--opt' string must match a variant name (case-sensitive) or a variant's
// integer value; anything else is a sema error naming the valid variant names.
//
// Expected (e.g. with '--opt os_choice=NotAnOS'): compilation fails with
//   error: option 'os_choice' value 'NotAnOS' does not match any variant of this enum;
//          valid values: Linux, Windows
//
// ('--opt os_choice=Windows' or '--opt os_choice=1' both succeed instead.)

pub type Os = enum(i32) {
    Linux = 0
    Windows = 1
}

const x: Os = @option("os_choice")

pub fn main() {
}
