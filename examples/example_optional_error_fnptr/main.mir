// example_optional_error_fnptr.mir — '?' works in function-POINTER types too, so a
// '?error(...)' function can be stored and called indirectly with the same drop-and-check
// behaviour as a direct call.

ext fn printf(fmt: *u8, ...) -> i32

type Alloc_Error = enum {
    Out_Of_Memory
}

fn heap_alloc(size: usize) -> (anyptr, ?Alloc_Error) {
    if size > 1024 {
        return_err .Out_Of_Memory
    }
    return_ok nil
}

fn probe(size: usize) -> ?Alloc_Error {
    if size > 1024 {
        return_err .Out_Of_Memory
    }
    return_ok
}

type Allocator = struct {
    alloc: fn(usize) -> (anyptr, ?Alloc_Error)
    probe: fn(usize) -> ?Alloc_Error
}

pub fn main() {
    const f: fn(usize) -> (anyptr, ?Alloc_Error) = heap_alloc

    // Through a local fn-pointer: the trailing slot is dropped and checked.
    const p := f(16)
    printf("local fn ptr: p is nil = %d\n", cast(p == nil, i32))

    // Through a struct field.
    const a: Allocator = { .alloc = heap_alloc, .probe = probe }
    const q := a.alloc(32)
    printf("struct field: q is nil = %d\n", cast(q == nil, i32))

    // Statement position through a fn pointer, with the error as the only return value.
    a.probe(64)
    printf("done\n")
}
