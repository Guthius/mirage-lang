pub type A = trait {
    fn a(self) -> i32
}
pub type B = trait {
    fn b(self) -> i32
}
pub type C = trait(A, B) {
    fn c(self) -> i32
}

pub type Impl = struct { v: i32 }
impl C for Impl {
    fn a(self) -> i32 { return self.v }
    fn b(self) -> i32 { return self.v + 1 }
    fn c(self) -> i32 { return self.v + 2 }
}
pub fn main() -> i32 {
    mut x: Impl = { .v = 10 }
    const c: C = &x
    return c.a() + c.b() + c.c() - 10 - 11 - 12
}
