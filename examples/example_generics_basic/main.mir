// example_generics_basic.mir — a generic type ('type List[T: type] = struct {...}') with a
// generic 'impl' block, exercising basic type-param instantiation, explicit generic
// instantiation as a struct field's declared type, and a method call through the receiver's
// generic instantiation ('self: List[i32]').
//
// Expected: compiles and runs, exit code 30 (10 + 20).

ext fn printf(fmt: *u8, ...) -> i32

pub type List[T: type] = struct {
    data: *T
    length: usize
}

impl List[T: type] {
    pub fn get(self, index: usize) -> T {
        return self.data[index]
    }
    pub fn set(mut self, index: usize, value: T) {
        self.data[index] = value
    }
}

pub fn main() -> i32 {
    mut buf: [4]i32 = {0, 0, 0, 0}
    mut list: List[i32] = { .data = &buf[0], .length = 4 }

    list.set(0, 10)
    list.set(1, 20)

    const sum := list.get(0) + list.get(1)
    printf("sum = %d\n", sum)
    return sum
}
