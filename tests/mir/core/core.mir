// tests/mir/core — arithmetic, control flow, aggregates, slices, pointers.
//
// Part of the corpus migration described in the self-hosting plan: positive fixtures
// (the ones that compile and RUN) move here as '@test' functions, where an assertion can
// say what it expected instead of encoding it in a process exit code. Negative fixtures --
// the ones that must produce a specific diagnostic -- stay in 'examples/' under
// tests/examples_expected.json, because a program that does not compile cannot be a test
// function.
//
// Run with:  mirage test tests/mir/core --std=<stdlib>

pub type Check = enum(i32) {
    Failed = 1
}

// The whole assertion vocabulary. A test returns 'error(Check)', so 'try' propagates a
// failure straight out of the test with no boilerplate at the call site.
pub fn expect(condition: bool) -> ?error(Check) {
    if !condition {
        return .Failed
    }
    return_ok
}

pub fn expect_eq_i64(actual: i64, expected: i64) -> ?error(Check) {
    if actual != expected {
        return .Failed
    }
    return_ok
}

pub fn expect_eq_usize(actual: usize, expected: usize) -> ?error(Check) {
    if actual != expected {
        return .Failed
    }
    return_ok
}

@test
fn test_integer_arithmetic() -> error(Check) {
    try expect_eq_i64(2 + 3, 5)
    try expect_eq_i64(10 - 4, 6)
    try expect_eq_i64(6 * 7, 42)
    try expect_eq_i64(20 / 3, 6)
    try expect_eq_i64(20 % 3, 2)
    try expect_eq_i64(-7 / 2, -3)   // truncating division, not floor
    try expect_eq_i64(-7 % 2, -1)
    return_ok
}

@test
fn test_bitwise_and_shifts() -> error(Check) {
    try expect_eq_i64(0b1100 & 0b1010, 0b1000)
    try expect_eq_i64(0b1100 | 0b1010, 0b1110)
    try expect_eq_i64(0b1100 ^ 0b1010, 0b0110)
    try expect_eq_i64(1 << 10, 1024)
    try expect_eq_i64(1024 >> 3, 128)
    // Arithmetic shift right keeps the sign.
    const negative: i64 = -16
    try expect_eq_i64(negative >> 2, -4)
    return_ok
}

@test
fn test_comparison_and_logical() -> error(Check) {
    try expect(1 < 2)
    try expect(2 <= 2)
    try expect(3 > 2)
    try expect(3 >= 3)
    try expect(1 != 2)
    try expect(!(1 == 2))
    try expect(true && true)
    try expect(true || false)
    try expect(!(false && true))
    return_ok
}

@test
fn test_short_circuit() -> error(Check) {
    // The right operand must not be evaluated when the left already decides the answer;
    // dividing by zero would trap if it were.
    mut denominator: i32 = 0
    if denominator != 0 && (100 / denominator) > 0 {
        return .Failed
    }
    if denominator == 0 || (100 / denominator) > 0 {
        return_ok
    }
    return .Failed
}

@test
fn test_control_flow() -> error(Check) {
    mut sum: i64 = 0
    mut i: i64 = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 7 {
            break
        }
        sum = sum + i
    }
    // 1 + 3 + 5 + 7 = 16
    try expect_eq_i64(sum, 16)
    return_ok
}

pub type Point = struct {
    x: i32
    y: i32
}

@test
fn test_struct_value_semantics() -> error(Check) {
    mut a: Point = default
    a.x = 1
    a.y = 2

    // Structs copy on assignment; mutating the copy must not touch the original.
    mut b := a
    b.x = 99
    try expect_eq_i64(cast(a.x, i64), 1)
    try expect_eq_i64(cast(b.x, i64), 99)
    try expect_eq_i64(cast(b.y, i64), 2)
    return_ok
}

@test
fn test_default_initialization() -> error(Check) {
    mut p: Point = default
    try expect_eq_i64(cast(p.x, i64), 0)
    try expect_eq_i64(cast(p.y, i64), 0)
    return_ok
}

@test
fn test_arrays_and_slices() -> error(Check) {
    mut values: [5]i32 = default
    mut i: usize = 0
    while i < 5 {
        values[i] = cast(i, i32) * 10
        i = i + 1
    }

    try expect_eq_i64(cast(values[3], i64), 30)

    const whole := values[..]
    try expect_eq_usize(len(whole), 5)

    const middle := values[1..4]
    try expect_eq_usize(len(middle), 3)
    try expect_eq_i64(cast(middle[0], i64), 10)
    try expect_eq_i64(cast(middle[2], i64), 30)
    return_ok
}

@test
fn test_for_in_by_value_and_reference() -> error(Check) {
    mut values: [4]i32 = default
    values[0] = 1
    values[1] = 2
    values[2] = 3
    values[3] = 4

    mut total: i64 = 0
    for v in values[..] {
        total = total + cast(v, i64)
    }
    try expect_eq_i64(total, 10)

    // By reference: the loop mutates the underlying array.
    for &v in values[..] {
        v.* = v.* * 2
    }
    try expect_eq_i64(cast(values[3], i64), 8)

    mut index_sum: i64 = 0
    for i, _ in values[..] {
        index_sum = index_sum + cast(i, i64)
    }
    try expect_eq_i64(index_sum, 6)
    return_ok
}

@test
fn test_pointers() -> error(Check) {
    mut value: i32 = 7
    const p := &value
    p.* = p.* + 1
    try expect_eq_i64(cast(value, i64), 8)

    mut point: Point = default
    const pp := &point
    pp.x = 5
    try expect_eq_i64(cast(point.x, i64), 5)
    return_ok
}

fn add_two(a: i32, b: i32) -> i32 {
    return a + b
}

@test
fn test_function_pointers() -> error(Check) {
    const f: fn(i32, i32) -> i32 = add_two
    try expect_eq_i64(cast(f(3, 4), i64), 7)
    return_ok
}

fn divide(a: i32, b: i32) -> (i32, i32) {
    return a / b, a % b
}

@test
fn test_multi_return() -> error(Check) {
    const quotient, remainder := divide(17, 5)
    try expect_eq_i64(cast(quotient, i64), 3)
    try expect_eq_i64(cast(remainder, i64), 2)
    return_ok
}

@test
fn test_defer_runs_lifo() -> error(Check) {
    mut order: [3]i32 = default
    mut next: usize = 0
    {
        defer {
            order[next] = 3
            next = next + 1
        }
        defer {
            order[next] = 2
            next = next + 1
        }
        order[next] = 1
        next = next + 1
    }
    try expect_eq_i64(cast(order[0], i64), 1)
    try expect_eq_i64(cast(order[1], i64), 2)
    try expect_eq_i64(cast(order[2], i64), 3)
    return_ok
}

pub type Direction = enum(u8) {
    North
    South
    East
    West
}

@test
fn test_enums_and_match() -> error(Check) {
    const d := Direction.East
    const value := match d {
        .North: 1,
        .South: 2,
        .East:  3,
        .West:  4,
    }
    try expect_eq_i64(cast(value, i64), 3)
    return_ok
}

@test
fn test_switch_statement() -> error(Check) {
    mut hits: i64 = 0
    const d := Direction.South
    switch d {
        .North: { hits = 1 },
        .South: { hits = 2 },
        // Deliberately not exhaustive: 'switch' is a statement and does not require it.
    }
    try expect_eq_i64(hits, 2)
    return_ok
}
