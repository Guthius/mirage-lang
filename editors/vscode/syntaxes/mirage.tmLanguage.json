{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mirage",
  "scopeName": "source.mirage",
  "fileTypes": ["mir"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#fn-declaration" },
    { "include": "#type-declaration" },
    { "include": "#impl-declaration" },
    { "include": "#asm-block" },
    { "include": "#directives" },
    { "include": "#attributes" },
    { "include": "#optional-error" },
    { "include": "#keywords" },
    { "include": "#support-types" },
    { "include": "#ext-modifier" },
    { "include": "#numbers" },
    { "include": "#dot-variant" },
    { "include": "#dot-property" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.mirage"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.mirage"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.mirage",
          "patterns": [{ "include": "#string-escape" }]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.mirage",
          "patterns": [{ "include": "#string-escape" }]
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "match": "\\\\(x[0-9A-Fa-f]{2}|[0-7]{1,3}|[\\\\\"'ntr])",
          "name": "constant.character.escape.mirage"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.unknown-escape.mirage"
        }
      ]
    },
    "fn-declaration": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.mirage" },
        "2": { "name": "entity.name.function.mirage" }
      }
    },
    "type-declaration": {
      "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.mirage" },
        "2": { "name": "entity.name.type.mirage" }
      }
    },
    "impl-declaration": {
      "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.mirage" },
        "2": { "name": "entity.name.type.mirage" }
      }
    },
    "asm-block": {
      "comment": "Matches both the statement form 'asm { ... }' and the expression form 'asm -> reg [: type] { ... }' — groups 2-5 are absent for the statement form.",
      "begin": "\\b(asm)\\b(?:\\s*(->)\\s*([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?)?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.other.mirage" },
        "2": { "name": "keyword.operator.arrow.mirage" },
        "3": { "name": "variable.language.register.asm.mirage" },
        "4": { "name": "punctuation.separator.colon.mirage" },
        "5": { "name": "storage.type.mirage" },
        "6": { "name": "punctuation.brackets.mirage" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.brackets.mirage" }
      },
      "name": "meta.embedded.block.asm.mirage",
      "patterns": [
        { "include": "#asm-comments" },
        { "include": "#asm-mnemonic" },
        { "include": "#asm-registers" },
        { "include": "#asm-numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "asm-comments": {
      "patterns": [
        { "match": ";.*$", "name": "comment.line.semicolon.asm.mirage" },
        { "match": "#.*$", "name": "comment.line.number-sign.asm.mirage" }
      ]
    },
    "asm-mnemonic": {
      "comment": "The first word on an instruction line — not validated against a fixed mnemonic list (unknown mnemonics are legal, sema-checked, not a parse error), so this is a positional highlight, not a semantic one.",
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.mnemonic.asm.mirage" }
      }
    },
    "asm-registers": {
      "match": "\\b(?i:rax|rbx|rcx|rdx|rdi|rsi|rsp|rbp|r8|r9|r10|r11|r12|r13|r14|r15|eax|ebx|ecx|edx|edi|esi|esp|ebp|r8d|r9d|r10d|r11d|r12d|r13d|r14d|r15d|ax|bx|cx|dx|di|si|sp|bp|r8w|r9w|r10w|r11w|r12w|r13w|r14w|r15w|al|bl|cl|dl|dil|sil|spl|bpl|r8b|r9b|r10b|r11b|r12b|r13b|r14b|r15b)\\b",
      "name": "variable.language.register.asm.mirage"
    },
    "asm-numbers": {
      "patterns": [
        { "match": "-?\\b0[xX][0-9A-Fa-f_]+\\b", "name": "constant.numeric.hex.mirage" },
        { "match": "-?\\b[0-9][0-9_]*\\b", "name": "constant.numeric.decimal.mirage" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(true|false|nil|default|undefined|iota)\\b",
          "name": "constant.language.mirage"
        },
        {
          "match": "\\b(for|while|if|else|match|switch|defer|break|continue|return|return_err|return_ok|in|when|try)\\b",
          "name": "keyword.control.mirage"
        },
        {
          "match": "\\b(const|mut|pub|namespace)\\b",
          "name": "storage.modifier.mirage"
        },
        {
          "match": "\\b(fn|type|trait|struct|impl|enum|union|error|bitset)\\b",
          "name": "storage.type.mirage"
        },
        {
          "match": "\\b(import_bin|import|asm|macro|size_of|align_of|type_of|type_info_of|offsetof|stackalloc|cast|len)\\b",
          "name": "keyword.other.mirage"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "\\$(option|env)\\b",
          "name": "keyword.other.directive.mirage"
        },
        {
          "match": "#(link|error|warn)\\b",
          "name": "keyword.other.directive.mirage"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "@(no_return|naked|always_inline|section|init)\\b",
          "name": "storage.type.annotation.mirage"
        },
        {
          "begin": "@(\\()",
          "beginCaptures": {
            "1": { "name": "storage.type.annotation.mirage" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "storage.type.annotation.mirage" }
          },
          "name": "meta.attribute-group.mirage",
          "patterns": [
            {
              "match": "\\b(no_return|naked|always_inline|section|init)\\b",
              "name": "storage.type.annotation.mirage"
            },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "optional-error": {
      "comment": "The '?' marking a function's last return type as an ignorable error ('-> (anyptr, ?Allocator_Error)'). Scoped as a modifier rather than an operator so it reads as part of the type, not as the ternary '?' that #operators would otherwise claim it as — hence this must be included BEFORE #operators. Distinguished from the ternary purely by what precedes it: a return slot's '?' always follows '->', ',' or '(', whereas a ternary's always follows an expression.",
      "patterns": [
        {
          "match": "(?<=[>,(])\\s*(\\?)(?=\\s*(?:[A-Za-z_]|\\berror\\b))",
          "captures": {
            "1": { "name": "storage.modifier.optional-error.mirage" }
          }
        }
      ]
    },
    "support-types": {
      "patterns": [
        {
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|usize|bool|byte|anyptr|any)\\b",
          "name": "support.type.primitive.mirage"
        }
      ]
    },
    "ext-modifier": {
      "patterns": [
        {
          "match": "\\bext\\b(?=\\s+fn\\b)",
          "name": "storage.modifier.mirage"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b",
          "name": "constant.numeric.hex.mirage"
        },
        {
          "match": "\\b0[bB][01_]+\\b",
          "name": "constant.numeric.binary.mirage"
        },
        {
          "match": "\\b0[oO][0-7_]+\\b",
          "name": "constant.numeric.octal.mirage"
        },
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b",
          "name": "constant.numeric.float.mirage"
        },
        {
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.mirage"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.decimal.mirage"
        }
      ]
    },
    "dot-variant": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_)\\]])\\.[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.enummember.mirage"
        }
      ]
    },
    "dot-property": {
      "patterns": [
        {
          "match": "\\.[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.mirage"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|:=|->|\\.\\.\\.|\\.\\.|\\+=|-=|\\*=|/=|&=|\\|=|\\^=|<<|>>|[+\\-*/%&|^~!=<>?:.]",
          "name": "keyword.operator.mirage"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[(){}\\[\\]]",
          "name": "punctuation.brackets.mirage"
        },
        {
          "match": "[,;]",
          "name": "punctuation.separator.mirage"
        }
      ]
    }
  }
}
